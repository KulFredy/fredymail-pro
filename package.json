{
  "name": "icerik-fabrikasi",
  "version": "0.1.0",
  "private": true,
  "description": "İçerik Fabrikası: Instagram Hızlı Edit ve Kurgu Stüdyosu (yerel, Türkçe)",
  "type": "module",
  "scripts": {
    "fabrika": "npm run build:web && tsx src/server/index.ts",
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build:web": "vite build --config web/vite.config.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit -p .",
    "e2e:studio": "tsx scripts/e2e-studio.ts",
    "e2e:offline": "tsx scripts/e2e-offline.ts",
    "e2e:ui": "tsx scripts/e2e-ui.ts",
    "e2e:lut": "tsx scripts/e2e-lut.ts",
    "lut-ekle": "tsx scripts/lut-ekle.ts",
    "e2e:ref": "tsx scripts/e2e-ref.ts",
    "e2e:grafik": "tsx scripts/e2e-grafik.ts",
    "e2e:ritim": "tsx scripts/e2e-ritim.ts",
    "e2e:baglanti": "tsx scripts/e2e-baglanti.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/bundler": "^4.0.541",
    "@remotion/player": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "fastify": "^5.12.8",
    "lucide-react": "^1.70.0",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
