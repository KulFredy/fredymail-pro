# FredyMail Next — örnek yapılandırma.
# Kopyalayın:  cp .env.example .env && chmod 600 .env
# Bu dosyadaki tüm değerler SAHTEDİR. Gerçek sırlar yalnızca sunucudaki .env'de (veya *_FILE ile
# gösterilen chmod 600 dosyalarda) durur; asla commit edilmez, loglara yazılmaz.

# ---------- Genel ----------
FM_ENV=production
FM_LOG_LEVEL=INFO
FM_HTTP_PORT=8088                 # yalnızca 127.0.0.1'e bağlanır

# ---------- Veritabanı / arama (uzun rastgele değerler: `openssl rand -base64 36`) ----------
FM_DB_PASSWORD=degistir-bunu-uzun-rastgele-veritabani-parolasi
FM_MEILI_MASTER_KEY=degistir-bunu-en-az-32-karakterlik-meili-anahtari
FM_MEILI_INDEX=fm_messages

# ---------- Giriş ----------
FM_ADMIN_USER=fatih
# `docker compose run --rm api fredymail hash-password` ile üretin (argon2id özeti, $ işaretleri için tek tırnak)
FM_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$ORNEKSAHTE$ORNEKSAHTEORNEKSAHTE'
# İki adımlı doğrulama (önerilir): `fredymail totp-setup` çıktısındaki sır
FM_TOTP_SECRET=
FM_SESSION_SECRET=degistir-bunu-en-az-32-karakterlik-oturum-sirri
FM_COOKIE_SECURE=true             # yalnızca HTTPS (Tunnel) — yerel http denemesi için false
FM_TRUST_PROXY=none               # Cloudflare Tunnel arkasında: cloudflare
FM_ALLOWED_ORIGINS=               # boş = yalnızca aynı origin (önerilen)

# ---------- Posta kaynağı ----------
# demo: sentetik veri | imap: canlı hesap (yalnızca okuma)
FM_MAIL_SOURCE=demo
FM_ACCOUNT_EMAIL=kullanici@ornek-sirket.test
FM_ACCOUNT_ALIASES=
# Sunucu adresini TAHMİN ETMEYİN: `fredymail discover <adres>` çıktısındaki öneriyi kullanın.
FM_IMAP_HOST=
FM_IMAP_PORT=993
FM_IMAP_SECURITY=ssl              # ssl | starttls (düz metin desteklenmez)
FM_IMAP_USERNAME=
FM_IMAP_PASSWORD=
# Tercihen parolayı dosyadan okuyun (docs/DAGITIM.md):
# FM_IMAP_PASSWORD_FILE=/run/secrets/imap_password

# Canlı senkron, `fredymail sync-plan` kapsamı onaylanana kadar KAPALI kalır.
FM_SYNC_ENABLED=false
FM_SYNC_INTERVAL_SECONDS=180
FM_SYNC_FOLDERS=auto              # auto = Çöp/Spam/Taslak/Karantina dışındaki tüm klasörler
FM_SYNC_SINCE=365d                # 365d | 2025-01-01 | all
FM_SYNC_MAX_MESSAGES_PER_FOLDER=5000
FM_SYNC_MAX_MESSAGES_PER_CYCLE=1000
FM_SYNC_BATCH_SIZE=25
FM_SYNC_BATCH_DELAY_MS=250
FM_SYNC_FULL_FETCH_MAX_BYTES=2097152   # bundan büyük maillerde yalnızca metin parçaları indirilir

# ---------- Ekler ----------
FM_ATTACHMENT_TEXT_EXTRACTION=false    # true: PDF/XLSX/CSV ekleri içinde arama (≤5 MB, çalıştırılmaz)
FM_ATTACHMENT_DOWNLOAD_MAX_BYTES=31457280

# ---------- AI (opsiyonel; kapalıyken arama/görüntüleme çalışır) ----------
# none | openai_compatible
FM_AI_PROVIDER=none
# VPS'teki LiteLLM proxy (docker-compose.vps.yml ile ai-shared ağı):
FM_AI_BASE_URL=http://litellm-litellm-1:4000/v1
FM_AI_API_KEY=
FM_AI_MODEL=flash-lite
FM_AI_DAILY_BUDGET_USD=1.00
FM_AI_MAX_CALLS_PER_DAY=100
FM_AI_PRICE_INPUT_PER_MTOK=0.10   # maliyet tahmini için (USD / 1M token)
FM_AI_PRICE_OUTPUT_PER_MTOK=0.40
# İkinci kademe (isteğe bağlı): taslaklar, uzun yazışmalar ve hafif modelin geçersiz çıktısında kullanılır.
# Boş bırakılırsa her şey FM_AI_MODEL ile yapılır.
FM_AI_MODEL_HEAVY=
FM_AI_PRICE_INPUT_PER_MTOK_HEAVY=2.00
FM_AI_PRICE_OUTPUT_PER_MTOK_HEAVY=12.00
FM_AI_HEAVY_KINDS=draft             # her zaman güçlü modelle yapılan işlemler (virgülle)
FM_AI_HEAVY_MIN_CHARS=15000         # bundan uzun bağlam güçlü modele gider
FM_AI_MAX_OUTPUT_TOKENS_HEAVY=8000  # "düşünen" modeller bu payın bir kısmını düşünmeye harcar
FM_AI_REASONING_EFFORT_HEAVY=low    # low|medium|high; boş = gönderme
FM_AI_MAX_MESSAGES=15
FM_AI_MAX_TOTAL_CHARS=30000
FM_AI_REDACT_PII=true

# ---------- İş akışı ----------
FM_AWAITING_REPLY_DAYS=3
FM_NEEDS_REPLY_DAYS=2

# ---------- Uyarılar (opsiyonel, mail içeriği gönderilmez) ----------
FM_ALERT_TELEGRAM_BOT_TOKEN=
FM_ALERT_TELEGRAM_CHAT_ID=

# ---------- Cloudflare Tunnel (opsiyonel, docker-compose.vps.yml --profile tunnel) ----------
FM_CLOUDFLARE_TUNNEL_TOKEN=
